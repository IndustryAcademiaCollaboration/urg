CREATE TABLE cl_victims (
  id            TEXT    PRIMARY KEY NOT NULL,
  session_id    TEXT    NOT NULL REFERENCES cl_sessions(id),
  severity      TEXT,
  can_walk      INTEGER,
  is_breathing  INTEGER,
  has_pulse     INTEGER,
  consciousness INTEGER,
  location      TEXT,
  feature       TEXT,
  recorded_at   INTEGER NOT NULL
);

insert:
INSERT INTO cl_victims (id, session_id, severity, can_walk, is_breathing, has_pulse, consciousness, location, feature, recorded_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE cl_victims SET location = ?, feature = ? WHERE id = ?;

updateSeverity:
UPDATE cl_victims SET severity = ? WHERE id = ?;

selectBySession:
SELECT * FROM cl_victims WHERE session_id = ? ORDER BY recorded_at ASC;

selectOrderedBySeverity:
SELECT * FROM cl_victims
ORDER BY
  CASE severity
    WHEN 'severe' THEN 0
    WHEN 'minor'  THEN 1
    ELSE               2
  END;

selectOrderedByTime:
SELECT * FROM cl_victims ORDER BY recorded_at ASC;

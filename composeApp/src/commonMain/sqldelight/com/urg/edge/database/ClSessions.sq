CREATE TABLE cl_sessions (
  id              TEXT    PRIMARY KEY NOT NULL,
  latitude        REAL,
  longitude       REAL,
  -- 対象者の表示ラベル（P番号）採番用カウンタ。削除の影響を受けず単調増加させることで
  -- 「セッション内max+1」方式（削除→再登録で番号が再利用される問題）を解消する
  next_display_no INTEGER NOT NULL DEFAULT 1,
  started_at      INTEGER NOT NULL
);

insert:
INSERT INTO cl_sessions (id, latitude, longitude, next_display_no, started_at)
VALUES (?, ?, ?, ?, ?);

selectAll:
SELECT * FROM cl_sessions ORDER BY started_at DESC;

selectById:
SELECT * FROM cl_sessions WHERE id = ?;

selectNextDisplayNo:
SELECT next_display_no FROM cl_sessions WHERE id = ?;

incrementNextDisplayNo:
UPDATE cl_sessions SET next_display_no = next_display_no + 1 WHERE id = ?;

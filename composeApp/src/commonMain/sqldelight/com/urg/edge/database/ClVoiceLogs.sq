CREATE TABLE cl_voice_logs (
  id          TEXT    PRIMARY KEY NOT NULL,
  victim_id   TEXT    NOT NULL REFERENCES cl_victims(id),
  transcript  TEXT    NOT NULL,
  parsed_json TEXT,
  embedding   BLOB,
  recorded_at INTEGER NOT NULL
);

insert:
INSERT INTO cl_voice_logs (id, victim_id, transcript, parsed_json, embedding, recorded_at)
VALUES (?, ?, ?, ?, NULL, ?);

selectByVictim:
SELECT * FROM cl_voice_logs WHERE victim_id = ? ORDER BY recorded_at ASC;

updateEmbedding:
UPDATE cl_voice_logs SET embedding = ? WHERE id = ?;
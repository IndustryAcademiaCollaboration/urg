;
; Configuration file of NAIST-jdic dictionary (open_jtalk_dic_utf_8-1.11)
; Generated for piper-plus-g2p-android consumption.
;
cost-factor = 800
bos-feature = BOS/EOS,*,*,*,*,*,*,*,*
eval-size = 11
unk-eval-size = 4
config-charset = UTF-8

; yomi
node-format-yomi = %f[9]
unk-format-yomi  = %m
eos-format-yomi  = \n

; simple
node-format-simple = %m\t%F-[0,1,2,3]\n
eos-format-simple  = EOS\n
